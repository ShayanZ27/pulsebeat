# ==========================================
# PulseBeat Backend Environment Configuration
# ==========================================

# Server Port
PORT=3000

# Environment Mode: 'development' or 'production'
NODE_ENV=production

# MongoDB Connection String (Atlas or self-hosted)
MONGO_DB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/pulsebeat?retryWrites=true&w=majority

# Secret for signing JWT authentication tokens
JWT_SECRET=your_super_secret_jwt_key_here

# Allowed Frontend Origins for CORS (comma-separated if multiple)
# e.g. https://pulsebeat.vercel.app,http://localhost:5173
CLIENT_URL=https://your-frontend-domain.vercel.app

# ImageKit Configuration for CDN media uploads
IMAGEKIT_PUBLIC_KEY=public_your_key_here
IMAGEKIT_PRIVATE_KEY=private_your_key_here
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your_endpoint_here
